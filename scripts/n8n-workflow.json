      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "🔐 ¿Es mi chat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 820]
    },
    {
      "parameters": {
        "jsCode": "// Parsear el mensaje de corrección\n// Formatos aceptados:\n// \"corrige: texto de corrección\" → usa el último proyecto\n// \"corrige proyecto_id: texto\" → especifica el proyecto\n\nconst msg = $input.item.json.message.text || '';\n\n// Guardar último proyecto en static data\nconst staticData = $getWorkflowStaticData('global');\n\nlet project = staticData.last_project || '';\nlet correction = '';\n\nconst match = msg.match(/^corrige\\s+([^:]+):\\s*(.+)/i);\nif (match) {\n  // Formato: \"corrige proyecto_id: texto\"\n  project = match[1].trim();\n  correction = match[2].trim();\n} else {\n  // Cualquier mensaje libre → corrección para el último proyecto\n  correction = msg.trim();\n}\n\nif (!project) {\n  return [{ json: { error: 'No hay proyecto activo. Inicia un pipeline primero.' } }];\n}\n\nif (!correction) {\n  return [{ json: { error: 'Escribe la corrección que quieres aplicar.' } }];\n}\n\nreturn [{ json: { project, correction, valid: true } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000011",
      "name": "🔍 Parsear Corrección",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 740]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-3",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
