    "HTTP - HTML":            { "main": [[{ "node": "Telegram - Renderizando","type": "main", "index": 0 }]] },
    "Telegram - Renderizando":{ "main": [[{ "node": "HTTP - Render",          "type": "main", "index": 0 }]] },
    "HTTP - Render":          { "main": [[{ "node": "Telegram - Preview 1",   "type": "main", "index": 0 }]] },
    "Telegram - Preview 1":   { "main": [[{ "node": "Telegram - Preview 2",   "type": "main", "index": 0 }]] },
    "Telegram - Preview 2":   { "main": [[{ "node": "Telegram - Preview 3",   "type": "main", "index": 0 }]] },
    "Telegram - Preview 3":   { "main": [[{ "node": "Telegram - Pedir Feedback","type": "main", "index": 0 }]] },
    "Telegram - Pedir Feedback":{ "main": [[{ "node": "Respond to Webhook",   "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
