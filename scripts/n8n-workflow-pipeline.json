        "responseBody": "={{ JSON.stringify({ ok: true, project: $('Webhook').item.json.body.project, message: 'Pipeline completado. Esperando feedback en Telegram.' }) }}"
      }
    }
  ],
  "connections": {
    "Webhook":                { "main": [[{ "node": "HTTP - Init",            "type": "main", "index": 0 }]] },
    "HTTP - Init":            { "main": [[{ "node": "Telegram - Inicio",      "type": "main", "index": 0 }]] },
    "Telegram - Inicio":      { "main": [[{ "node": "HTTP - Download",        "type": "main", "index": 0 }]] },
    "HTTP - Download":        { "main": [[{ "node": "HTTP - Transcribe",      "type": "main", "index": 0 }]] },
    "HTTP - Transcribe":      { "main": [[{ "node": "HTTP - Cut",             "type": "main", "index": 0 }]] },
