    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o', response_format: { type: 'json_object' }, max_tokens: 16000, temperature: 0.7, messages: [{ role: 'system', content: $json.system_prompt }, { role: 'user', content: $json.user_message }] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "3fe48c94-1817-497f-9a2b-835c9d332444",
      "name": "HTTP - OpenAI Beats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        11360,
        1504
      ],
      "credentials": {
        "openAiApi": {
          "id": "jxlWk54uGLrXnR7X",
          "name": "OpenAI account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extraer contenido de la respuesta de OpenAI\nlet content = $json.choices?.[0]?.message?.content || $json.message?.content || '';\n\n// Limpiar markdown si viene envuelto\ncontent = content.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(content);\n} catch(e) {\n  // Intentar extraer el JSON del texto\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try { parsed = JSON.parse(match[0]); }\n    catch(e2) { throw new Error('OpenAI no devolvió JSON válido: ' + content.slice(0, 300)); }\n  } else {\n    throw new Error('No se encontró JSON en la respuesta: ' + content.slice(0, 300));\n  }\n}\n\nconst dl = $('HTTP - Download').item.json;\nconst wb = $('Webhook').item.json;\n\nif (!parsed.beats || !Array.isArray(parsed.beats) || parsed.beats.length === 0) {\n  throw new Error('OpenAI no generó beats. Respuesta: ' + content.slice(0, 200));\n}\n\nreturn [{\n  json: {\n    beats: parsed.beats,\n    video_w: dl.video_w,\n    video_h: dl.video_h,\n    fps: dl.fps,\n    project: wb.body?.project\n  }\n}];"
      },
