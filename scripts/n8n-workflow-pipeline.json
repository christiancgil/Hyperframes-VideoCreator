{
  "name": "HyperFrames - Pipeline Principal",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "hyperframes-pipeline",
        "responseMode": "lastNode",
        "options": {}
      },
      "notes": "Recibe: { client_name, project, style? }\nEjemplo: { \"client_name\": \"DM Seguros\", \"project\": \"dm-2024-01\" }"
    },
    {
      "id": "2",
      "name": "HTTP - Init",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/init",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $json.body.project, client_name: $json.body.client_name, style: $json.body.style || '' }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "3",
      "name": "Telegram - Inicio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "5126250705",
        "text": "={{ '🎬 Pipeline iniciado\\n📁 Proyecto: ' + $('Webhook').item.json.body.project + '\\n👤 Cliente: ' + $('Webhook').item.json.body.client_name + '\\n\\nDescargando vídeo desde Drive...' }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "Telegram Hyperframes Bot"
        }
      }
    },
    {
      "id": "4",
      "name": "HTTP - Download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/download",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $('Webhook').item.json.body.project, client_name: $('Webhook').item.json.body.client_name }) }}",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "5",
      "name": "HTTP - Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $('Webhook').item.json.body.project }) }}",
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "6",
      "name": "HTTP - Cut",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/cut",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $('Webhook').item.json.body.project }) }}",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "7",
      "name": "Telegram - Planificando",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "5126250705",
        "text": "={{ '✂️ Descarga, transcripción y corte listos.\\n🤖 Planificando motion graphics con IA...' }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "Telegram Hyperframes Bot"
        }
      }
    },
    {
      "id": "8",
      "name": "Code - Preparar Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300],
      "parameters": {
        "jsCode": "const init = $('HTTP - Init').item.json;\nconst dl   = $('HTTP - Download').item.json;\nconst tr   = $('HTTP - Transcribe').item.json;\nconst wb   = $('Webhook').item.json;\n\nconst systemPrompt = `Eres un editor de vídeo con IA especializado en motion graphics para redes sociales.\n\nTu tarea: planificar los beats de motion graphics para el vídeo y generar el HTML completo de cada uno.\n\nREGLAS ABSOLUTAS DE HTML:\n- body { background: transparent !important; width: ${dl.video_w}px; height: ${dl.video_h}px; margin: 0; padding: 0; overflow: hidden; }\n- Nunca fondo sólido en el body. Nunca background: #000 ni similar.\n- Fuentes desde Google Fonts (incluir el <link> en el <head>)\n- animation-fill-mode: forwards en todas las animaciones\n- Sin hardcodear resoluciones — usar siempre ${dl.video_w}px y ${dl.video_h}px\n\nESTILO DEL CLIENTE:\n${init.styles?.client_style || ''}\n\nFILOSOFÍA DE MOVIMIENTO:\n${init.styles?.motion_philosophy || ''}\n\nTRIGGERS (cuándo activar cada animación):\n${init.styles?.triggers || ''}\n\nCATÁLOGO DE EFECTOS DISPONIBLES:\n${init.styles?.effects_catalog || ''}\n\nREGLAS POR ASPECT RATIO:\n${init.styles?.aspect_ratios || ''}\n\nResponde ÚNICAMENTE con JSON válido, sin markdown, con este formato exacto:\n{\"beats\":[{\"id\":\"beat_01\",\"type\":\"titulo-impacto\",\"start\":2.5,\"duration\":4.0,\"position\":\"CARD_CENTER\",\"html_content\":\"<!DOCTYPE html>...\"}]}`;\n\nconst userMessage = `Vídeo: ${dl.video_w}×${dl.video_h} @ ${dl.fps}fps — Duración total: ${dl.duration}s\n\nTRANSCRIPCIÓN COMPLETA:\n${tr.text || ''}\n\nPALABRAS CON TIMESTAMPS (JSON):\n${JSON.stringify((tr.words || []).slice(0, 300))}\n${dl.script ? '\\nGUION Y ESCENAS (voice over):\\n' + JSON.stringify(dl.script, null, 2) : ''}\n\nPlanifica todos los beats y genera el HTML completo de cada uno siguiendo el estilo del cliente.`;\n\nreturn [{\n  json: {\n    system_prompt: systemPrompt,\n    user_message: userMessage,\n    project: wb.body?.project,\n    video_w: dl.video_w,\n    video_h: dl.video_h,\n    fps: dl.fps\n  }\n}];"
      }
    },
    {
      "id": "9",
      "name": "HTTP - OpenAI Beats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o', response_format: { type: 'json_object' }, max_tokens: 16000, temperature: 0.7, messages: [{ role: 'system', content: $json.system_prompt }, { role: 'user', content: $json.user_message }] }) }}",
        "options": { "timeout": 120000 }
      },
      "credentials": {
        "openAiApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "10",
      "name": "Code - Parsear Beats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 300],
      "parameters": {
        "jsCode": "// Extraer contenido de la respuesta de OpenAI\nlet content = $json.choices?.[0]?.message?.content || $json.message?.content || '';\n\n// Limpiar markdown si viene envuelto\ncontent = content.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(content);\n} catch(e) {\n  // Intentar extraer el JSON del texto\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try { parsed = JSON.parse(match[0]); }\n    catch(e2) { throw new Error('OpenAI no devolvió JSON válido: ' + content.slice(0, 300)); }\n  } else {\n    throw new Error('No se encontró JSON en la respuesta: ' + content.slice(0, 300));\n  }\n}\n\nconst dl = $('HTTP - Download').item.json;\nconst wb = $('Webhook').item.json;\n\nif (!parsed.beats || !Array.isArray(parsed.beats) || parsed.beats.length === 0) {\n  throw new Error('OpenAI no generó beats. Respuesta: ' + content.slice(0, 200));\n}\n\nreturn [{\n  json: {\n    beats: parsed.beats,\n    video_w: dl.video_w,\n    video_h: dl.video_h,\n    fps: dl.fps,\n    project: wb.body?.project\n  }\n}];"
      }
    },
    {
      "id": "11",
      "name": "HTTP - HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/html",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $json.project, beats: $json.beats, video_w: $json.video_w, video_h: $json.video_h, fps: $json.fps }) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "12",
      "name": "Telegram - Renderizando",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2420, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "5126250705",
        "text": "={{ '🎨 ' + $('Code - Parsear Beats').item.json.beats.length + ' animaciones generadas. Renderizando con Puppeteer...\\n⏳ Esto puede tardar varios minutos.' }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "Telegram Hyperframes Bot"
        }
      }
    },
    {
      "id": "13",
      "name": "HTTP - Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 300],
      "parameters": {
        "method": "POST",
        "url": "http://187.124.238.94:4000/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $('Webhook').item.json.body.project }) }}",
        "options": { "timeout": 600000 }
      }
    },
    {
      "id": "14",
