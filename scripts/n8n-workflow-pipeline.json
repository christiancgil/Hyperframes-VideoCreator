    "Telegram - Planificando":{ "main": [[{ "node": "Code - Preparar Prompt", "type": "main", "index": 0 }]] },
    "Code - Preparar Prompt": { "main": [[{ "node": "HTTP - OpenAI Beats",    "type": "main", "index": 0 }]] },
