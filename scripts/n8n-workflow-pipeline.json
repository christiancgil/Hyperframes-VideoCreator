    },
    {
      "id": "15",
      "name": "Telegram - Preview 2",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3080, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "5126250705",
        "file": "={{ 'http://187.124.238.94:4000/preview/' + $('Webhook').item.json.body.project + '/2' }}",
        "additionalFields": {
          "caption": "Frame 2 — segundo 0:05"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "Telegram Hyperframes Bot"
        }
      }
    },
    {
      "id": "16",
      "name": "Telegram - Preview 3",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3300, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "5126250705",
        "file": "={{ 'http://187.124.238.94:4000/preview/' + $('Webhook').item.json.body.project + '/3' }}",
        "additionalFields": {
          "caption": "Frame 3 — segundo 0:10"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "Telegram Hyperframes Bot"
        }
      }
    },
    {
      "id": "17",
      "name": "Telegram - Pedir Feedback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [3520, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "5126250705",
        "text": "={{ '✅ Render completo — Proyecto: <b>' + $('Webhook').item.json.body.project + '</b>\\n\\nResponde <b>OK</b> para subir a Drive, o describe los cambios que quieres.' }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
